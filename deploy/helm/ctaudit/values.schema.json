{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "serviceAccount", "aws", "loki", "scanners", "service"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"type": "array"},
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "roleArn": {"type": "string"}
      },
      "if": {"properties": {"create": {"const": true}}},
      "then": {
        "required": ["roleArn"],
        "properties": {"roleArn": {"type": "string", "pattern": "^arn:aws[a-z-]*:iam::\\d{12}:role/.+$"}}
      }
    },
    "aws": {
      "type": "object",
      "properties": {
        "bucket": {"type": "string"},
        "bucketRegion": {"type": "string"},
        "accounts": {"$ref": "#/definitions/accounts"},
        "regions": {"$ref": "#/definitions/regions"}
      }
    },
    "loki": {
      "type": "object",
      "properties": {
        "url": {"type": "string"},
        "tenant": {"type": "string"},
        "existingSecret": {"type": "string"},
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token": {"type": "string"},
            "user": {"type": "string"},
            "password": {"type": "string"}
          }
        }
      }
    },
    "scanners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "subcommand"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 30},
          "subcommand": {"type": "string", "enum": ["cloudtrail", "elb"]},
          "interval": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(h|m|s))+$"},
          "lookback": {"type": "string", "pattern": "^([0-9]+(\\.[0-9]+)?(h|m|s))+$"},
          "bucket": {"type": "string"},
          "accounts": {"$ref": "#/definitions/accounts"},
          "regions": {"$ref": "#/definitions/regions"},
          "args": {"type": "array", "items": {"type": "string"}},
          "resources": {"type": "object"},
          "debug": {"type": "boolean"},
          "logFormat": {"$ref": "#/definitions/logFormat"}
        }
      }
    },
    "debug": {"type": "boolean"},
    "logFormat": {"$ref": "#/definitions/logFormat"},
    "resources": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "service": {
      "type": "object",
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "string"},
        "labels": {"type": "object"}
      }
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "labels": {"type": "object"}
      }
    }
  },
  "definitions": {
    "logFormat": {"type": "string", "enum": ["text", "json"]},
    "accounts": {"type": "array", "items": {"type": "string", "pattern": "^\\d{12}$"}},
    "regions": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-\\d$"}}
  }
}
